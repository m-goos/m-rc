{
  "name": "m-rc.nl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build-open": "pnpm run clean && pnpm run build && pnpm run serve-build",
    "start": "next start",
    "lint": "eslint .",
    "prettier": "prettier --write --cache .",
    "prettier:ci": "prettier --check .",
    "check-types": "tsc --noEmit",
    "commit": "cz",
    "prepare": "husky",
    "clean": "rm -rf .next/ && rm -rf out/",
    "serve-build": "node scripts/serve-static.mjs",
    "test:e2e": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@tailwindcss/typography": "^0.5.10",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "gray-matter": "^4.0.3",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.32.1",
    "shiki": "^4.4.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@playwright/test": "^1.62.1",
    "autoprefixer": "^10.4.13",
    "commitizen": "^4.3.1",
    "concurrently": "^8.2.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "tailwindcss": "^3.3.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
